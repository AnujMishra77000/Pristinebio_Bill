# Application
APP_ENVIRONMENT=development
API_V1_PREFIX=/api/v1
BACKEND_PORT=8000
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Empty for local root routes. Production under this domain uses /bill.
NEXT_PUBLIC_BASE_PATH=

# Security
JWT_SECRET_KEY=
MFA_ENCRYPTION_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
SESSION_IDLE_MINUTES=480
REFRESH_CONCURRENCY_GRACE_SECONDS=10
# false ONLY on local HTTP. Production requires true and an HTTPS origin.
COOKIE_SECURE=false
# PostgreSQL
POSTGRES_DB=billing
POSTGRES_USER=billing
POSTGRES_PASSWORD=billing
# Use `postgres` for Docker Compose; use `localhost` when running the backend on the host.
DATABASE_URL=postgresql+psycopg://billing:billing@postgres:5432/billing

# Reserved for later background jobs
# Use `redis` for Docker Compose; use `localhost` when running the backend on the host.
REDIS_URL=redis://redis:6379/0

# Invoice PDF storage
PDF_STORAGE_DIR=./storage/invoices

# Production process/observability
WEB_CONCURRENCY=2
# Optional: send redacted structured error events to the deployment collector.
ERROR_TRACKING_DSN=

# For production, use deploy/create_env.py or deploy/.env.example:
# APP_ENVIRONMENT=production
# FRONTEND_ORIGIN=https://www.pristinebiopharma.in
# NEXT_PUBLIC_BASE_PATH=/bill
# NEXT_PUBLIC_API_BASE_URL=/bill/api/v1

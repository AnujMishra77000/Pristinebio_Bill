# Application
APP_ENVIRONMENT=development
API_V1_PREFIX=/api/v1
BACKEND_PORT=8000
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Security
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-one-time-random-token
ADMIN_REGISTRATION_MASTER_PASSWORD=replace-with-a-private-admin-registration-master-password

# PostgreSQL
POSTGRES_DB=billing
POSTGRES_USER=billing
POSTGRES_PASSWORD=billing
# Use `postgres` for Docker Compose; use `localhost` when running the backend on the host.
DATABASE_URL=postgresql+psycopg://billing:billing@postgres:5432/billing

# Reserved for later background jobs
# Use `redis` for Docker Compose; use `localhost` when running the backend on the host.
REDIS_URL=redis://redis:6379/0

# Invoice PDF storage
PDF_STORAGE_DIR=./storage/invoices
